{
  "name": "arcade",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "generate": "node scripts/generate-manifests.mjs",
    "generate:check": "node scripts/generate-manifests.mjs --check",
    "test": "node --test",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "verify:discover": "plugins discover .",
    "verify:claude": "claude plugin validate . --strict",
    "verify": "npm run check && npm run generate:check && npm run validate:schemas && npm run typecheck && npm test && npm run verify:discover && npm run verify:claude",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.258",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "plugins": "1.3.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "22.23.2"
  }
}
