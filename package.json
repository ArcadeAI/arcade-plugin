{
  "name": "arcade-agents",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "verify:discover": "npx --yes plugins@1.3.4 discover .",
    "verify:claude": "npx --yes @anthropic-ai/claude-code plugin validate .",
    "build:mcpb": "node scripts/build-claude-desktop-mcpb.mjs",
    "verify": "npm run check && npm run validate:schemas && npm test && npm run verify:discover && npm run verify:claude && npm run build:mcpb"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=18"
  }
}
