{
  "name": "arcade",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "package:claude": "node scripts/package-claude.mjs",
    "test": "node --test",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "verify:discover": "plugins discover .",
    "verify:claude": "claude plugin validate .",
    "verify": "npm run check && npm run validate:schemas && npm test && npm run verify:discover && npm run verify:claude"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.258",
    "ajv": "8.20.0",
    "plugins": "1.3.4"
  },
  "engines": {
    "node": "22.23.2"
  }
}
