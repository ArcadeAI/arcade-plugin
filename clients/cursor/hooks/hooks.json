{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/session-start.mjs\""
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/prompt-telemetry.mjs\"",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/post-arcade-tool.mjs\" success",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/post-arcade-tool.mjs\" failure",
        "matcher": "^(?:MCP:)?Arcade_.*$",
        "timeout": 5
      }
    ]
  }
}
