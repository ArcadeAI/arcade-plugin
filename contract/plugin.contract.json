{
  "identity": {
    "name": "arcade",
    "description": "Your agent, every app you've connected. Ask in plain English — email, calendar, issues, chat — and Arcade finds and runs the right tool. Sign in once in the browser — without ever handing your agent a key.",
    "author": {
      "name": "Arcade.dev",
      "url": "https://arcade.dev"
    },
    "homepage": "https://arcade.dev",
    "repository": "https://github.com/ArcadeAI/arcade-plugin",
    "license": "MIT",
    "keywords": [
      "arcade",
      "mcp",
      "agent-skills",
      "connected-apps"
    ]
  },
  "schemas": {
    "plugin": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "mcp": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "marketplace": "https://json.schemastore.org/claude-code-marketplace.json"
  },
  "gateway": {
    "serverName": "arcade",
    "url": "https://api.arcade.dev/mcp/arcade",
    "transports": {
      "portable": "streamable-http",
      "claude": "http",
      "cursor": "url-only"
    }
  },
  "hosts": {
    "cursor": {
      "skills": "skills",
      "agents": "agents",
      "commands": "commands",
      "rules": "clients/cursor/rules",
      "hooks": "clients/cursor/hooks/hooks.json",
      "mcpServers": "clients/cursor/mcp.json"
    },
    "claude": {
      "mcpServers": "./clients/claude/mcp.json"
    },
    "codex": {
      "skills": "./skills",
      "hooks": [
        "./hooks/hooks.json",
        "./com.openai/hooks/hooks.json"
      ],
      "mcpServers": "./mcp.json"
    }
  },
  "marketplace": {
    "description": "Install Arcade in Claude Desktop, Cowork, and Claude Code.",
    "displayName": "Arcade",
    "owner": {
      "name": "Arcade.dev",
      "url": "https://arcade.dev"
    }
  }
}
