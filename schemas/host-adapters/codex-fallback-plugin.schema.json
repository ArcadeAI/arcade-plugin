{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArcadeAI/arcade-plugin/schemas/host-adapters/codex-fallback-plugin.schema.json",
  "title": "Arcade Codex fallback plugin adapter manifest",
  "$comment": "Generated by scripts/generate-manifests.mjs. Current Codex reads root plugin.json and ignores this file; older loaders default skills to skills/ but MCP only to .mcp.json, so mcpServers points at mcp.json. Source checked 2026-09-17: https://developers.openai.com/plugins/build/plugins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "author",
    "homepage",
    "license",
    "keywords",
    "version",
    "mcpServers",
    "interface"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "homepage": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w.-]+)?(\\+[\\w.-]+)?$"
    },
    "mcpServers": { "const": "./mcp.json" },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "shortDescription",
        "developerName",
        "category",
        "websiteURL"
      ],
      "properties": {
        "displayName": { "const": "Arcade" },
        "shortDescription": { "type": "string", "minLength": 1 },
        "developerName": { "const": "Arcade.dev" },
        "category": { "type": "string", "minLength": 1 },
        "websiteURL": { "type": "string", "minLength": 1 }
      }
    }
  }
}
