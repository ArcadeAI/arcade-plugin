{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArcadeAI/arcade-plugin/schemas/host-adapters/cursor-hooks.schema.json",
  "title": "Arcade Cursor hook adapter contract",
  "$comment": "Repository-owned contract for the documented Cursor hook subset used here. sessionStart is the only Cursor hook that can inject additional_context. Source checked 2026-09-17: https://cursor.com/docs/hooks",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hooks"],
  "properties": {
    "version": {
      "const": 1
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionStart"],
      "properties": {
        "sessionStart": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "timeout"],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "timeout": {
                "type": "integer",
                "const": 5
              }
            }
          }
        }
      }
    }
  }
}
