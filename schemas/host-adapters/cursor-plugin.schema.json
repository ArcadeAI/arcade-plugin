{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArcadeAI/arcade-plugin/schemas/host-adapters/cursor-plugin.schema.json",
  "title": "Arcade Cursor plugin adapter manifest",
  "$comment": "Generated by scripts/generate-manifests.mjs. Source checked 2026-09-17: https://cursor.com/docs/reference/plugins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "author",
    "homepage",
    "license",
    "keywords",
    "version",
    "displayName",
    "skills",
    "agents",
    "commands",
    "rules",
    "hooks",
    "mcpServers"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "homepage": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "displayName": { "const": "Arcade" },
    "skills": { "const": "skills" },
    "agents": { "const": "agents" },
    "commands": { "const": "commands" },
    "rules": { "const": "clients/cursor/rules" },
    "hooks": { "const": "clients/cursor/hooks/hooks.json" },
    "mcpServers": { "const": "clients/cursor/mcp.json" }
  }
}
