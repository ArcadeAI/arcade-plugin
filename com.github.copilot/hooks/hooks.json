{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\" --host copilot",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\" --host copilot",
        "timeout": 5
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/subagent-start.mjs\" --host copilot",
        "timeout": 5
      }
    ]
  }
}
